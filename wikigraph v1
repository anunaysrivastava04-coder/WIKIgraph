    <!-- Application JavaScript Logic -->
    <script>
        let network = null;
        let physicsEnabled = true;
        let clusteredMode = false;
        let currentTopic = "";
        let currentSummary = "";
        let currentLinks = [];
        let allGraphNodes = [];
        let allGraphEdges = [];
        
        // Persistent stores
        let searchHistory = JSON.parse(localStorage.getItem('wikigraph_history')) || [];
        let bookmarks = JSON.parse(localStorage.getItem('wikigraph_bookmarks')) || [];

        // Initialization on window load
        window.onload = () => {
            updateBookmarkBadge();
            quickSearch("Artificial Intelligence");
        };

        // Toast Notification Helper
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast px-4 py-3 rounded-2xl shadow-xl text-sm font-medium flex items-center gap-3 border backdrop-blur-md ${
                type === 'success' 
                    ? 'bg-slate-900/90 text-white border-slate-800' 
                    : 'bg-indigo-600 text-white border-indigo-500'
            }`;
            toast.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle text-emerald-400' : 'fa-info-circle text-indigo-200'}"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Tab Switcher
        function switchTab(tabId) {
            ['explore', 'history', 'bookmarks'].forEach(id => {
                document.getElementById(`tab-${id}`).classList.add('hidden');
                const nav = document.getElementById(`nav-${id}`);
                if(nav) {
                    nav.classList.remove('bg-indigo-600', 'text-white', 'shadow-md', 'shadow-indigo-600/20');
                    nav.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-slate-800/60');
                }
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            if(activeNav) {
                activeNav.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-slate-800/60');
                activeNav.classList.add('bg-indigo-600', 'text-white', 'shadow-md', 'shadow-indigo-600/20');
            }

            if (tabId === 'history') renderHistoryList();
            if (tabId === 'bookmarks') renderBookmarksList();
        }

        // Quick Search from Pills
        function quickSearch(topic) {
            document.getElementById('searchInput').value = topic;
            switchTab('explore');
            startSearch();
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') startSearch();
        }

        function startSearch() {
            const topic = document.getElementById("searchInput").value.trim();
            if (topic !== "") {
                fetchWikiData(topic);
            }
        }

        async function fetchWikiData(topic) {
            document.getElementById("loading").style.display = "flex";
            document.getElementById("main-grid").style.display = "none";
            
            const url = `https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&prop=extracts|links&exintro=1&explaintext=1&pllimit=20&plnamespace=0&titles=${encodeURIComponent(topic)}`;
            
            try {
                const response = await fetch(url);
                const data = await response.json();
                const pages = data.query.pages;
                const pageId = Object.keys(pages)[0];

                if (pageId == "-1") {
                    showToast(`Topic "${topic}" not found on Wikipedia.`, 'info');
                    document.getElementById("loading").style.display = "none";
                    document.getElementById("main-grid").style.display = "grid";
                    return;
                }

                const pageData = pages[pageId];
                currentTopic = pageData.title;
                currentSummary = pageData.extract ? pageData.extract : "No summary available for this topic.";
                currentLinks = pageData.links ? pageData.links.map(link => link.title) : [];

                updateUI();
                buildAdvancedGraph(currentTopic, currentLinks);
                addToHistory(currentTopic);

                document.getElementById("loading").style.display = "none";
                document.getElementById("main-grid").style.display = "grid";

            } catch (error) {
                console.error("Error:", error);
                showToast("Failed to retrieve Wikipedia data. Check connection.", 'info');
                document.getElementById("loading").style.display = "none";
                document.getElementById("main-grid").style.display = "grid";
            }
        }

        function updateUI() {
            document.getElementById("topic-title").innerText = currentTopic;
            document.getElementById("topic-summary").innerText = currentSummary;
            document.getElementById("wiki-link").href = `https://en.wikipedia.org/wiki/${encodeURIComponent(currentTopic)}`;
            document.getElementById("searchInput").value = currentTopic;

            // Reading time estimation
            const wordCount = currentSummary.split(/\s+/).length;
            const readTime = Math.ceil(wordCount / 180);
            document.getElementById("reading-time").innerHTML = `<i class="far fa-clock mr-1"></i> ${readTime} min read`;

            // Populate Connected Articles List
            const listContainer = document.getElementById("related-list");
            listContainer.innerHTML = "";
            document.getElementById("related-count").innerText = `${currentLinks.length} items`;

            if (currentLinks.length === 0) {
                listContainer.innerHTML = `<li class="text-xs text-slate-400 py-3 text-center">No connected links available.</li>`;
            } else {
                currentLinks.forEach(link => {
                    const li = document.createElement("li");
                    li.className = "flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer transition border border-transparent hover:border-slate-200 dark:hover:border-slate-700/60 group";
                    li.innerHTML = `
                        <div class="flex items-center gap-3 truncate">
                            <div class="w-2 h-2 rounded-full bg-indigo-400 group-hover:scale-125 transition"></div>
                            <span class="text-sm font-medium text-slate-700 dark:text-slate-200 truncate">${link}</span>
                        </div>
                        <i class="fas fa-chevron-right text-xs text-slate-300 dark:text-slate-600 group-hover:text-indigo-500 transition"></i>
                    `;
                    li.onclick = () => {
                        document.getElementById("searchInput").value = link;
                        startSearch();
                    };
                    listContainer.appendChild(li);
                });
            }

            // Update bookmark button state
            updateBookmarkButtonState();
        }

        function buildAdvancedGraph(centerNode, connectedNodes) {
            const container = document.getElementById('graph-container');
            
            allGraphNodes = [];
            allGraphEdges = [];

            const isDark = document.documentElement.classList.contains('dark');
            const centerBg = '#6366f1';
            const centerBorder = '#4338ca';
            const nodePalette = ['#3b82f6', '#8b5cf6', '#ec4899', '#10b981', '#f59e0b', '#06b6d4', '#818cf8', '#a855f7'];

            // Central Hub Node with High Priority styling
            allGraphNodes.push({
                id: centerNode, 
                label: centerNode, 
                color: { background: centerBg, border: centerBorder, highlight: { background: '#4f46e5', border: '#312e81' } }, 
                font: { size: 16, color: isDark ? '#f8fafc' : '#1e293b', face: 'Inter', bold: true },
                shape: 'dot',
                size: 32,
                shadow: { enabled: true, color: 'rgba(0,0,0,0.3)', size: 12 },
                group: 'hub'
            });

            // Connected Nodes with varied sizing based on connectivity index
            connectedNodes.forEach((node, index) => {
                const nodeColor = nodePalette[index % nodePalette.length];
                allGraphNodes.push({
                    id: node, 
                    label: node, 
                    color: { background: nodeColor, border: nodeColor }, 
                    font: { size: 13, color: isDark ? '#cbd5e1' : '#475569', face: 'Inter' },
                    shape: 'dot',
                    size: 16,
                    shadow: { enabled: true, color: 'rgba(0,0,0,0.15)', size: 6 },
                    group: index % 2 === 0 ? 'branchA' : 'branchB'
                });
                
                allGraphEdges.push({
                    from: centerNode, 
                    to: node,
                    color: { color: isDark ? '#334155' : '#cbd5e1', highlight: '#6366f1' },
                    width: 2.5,
                    smooth: { type: 'cubicBezier', roundness: 0.3 }
                });
            });

            // Update Graph Statistics Telemetry summary
            document.getElementById('graph-stats-summary').innerText = `Nodes: ${allGraphNodes.length} | Edges: ${allGraphEdges.length}`;

            renderVisNetwork();
        }

        function renderVisNetwork() {
            const container = document.getElementById('graph-container');
            const isDark = document.documentElement.classList.contains('dark');

            const data = {
                nodes: new vis.DataSet(allGraphNodes),
                edges: new vis.DataSet(allGraphEdges)
            };

            const options = {
                nodes: {
                    borderWidth: 2,
                    margin: 12
                },
                physics: {
                    enabled: physicsEnabled,
                    barnesHut: {
                        gravitationalConstant: -4000,
                        centralGravity: 0.35,
                        springLength: 200,
                        springConstant: 0.04,
                        damping: 0.09
                    }
                },
                interaction: { 
                    hover: true,
                    zoomView: true,
                    dragView: true,
                    navigationButtons: true,
                    keyboard: true
                }
            };

            if (network !== null) {
                network.destroy();
            }
            network = new vis.Network(container, data, options);

            // Click & Double-Click node navigation
            network.on("click", function (params) {
                if (params.nodes.length > 0) {
                    const clickedTopic = params.nodes[0];
                    if (clickedTopic !== currentTopic) {
                        document.getElementById("searchInput").value = clickedTopic;
                        startSearch();
                    }
                }
            });

            network.on("doubleClick", function (params) {
                if (params.nodes.length > 0) {
                    const clickedTopic = params.nodes[0];
                    showToast(`Expanding sub-graph for "${clickedTopic}"...`, 'info');
                    document.getElementById("searchInput").value = clickedTopic;
                    startSearch();
                }
            });
        }

        function resetGraphZoom() {
            if (network) {
                network.fit({ animation: { duration: 800, easingFunction: 'easeInOutQuad' } });
            }
        }

        function togglePhysics() {
            physicsEnabled = !physicsEnabled;
            if (network) {
                network.setOptions({ physics: { enabled: physicsEnabled } });
            }
            const btn = document.getElementById('physics-btn');
            if (physicsEnabled) {
                btn.classList.add('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400');
                showToast('Physics simulation enabled');
            } else {
                btn.classList.remove('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400');
                showToast('Physics simulation paused');
            }
        }

        function toggleClustering() {
            clusteredMode = !clusteredMode;
            const btn = document.getElementById('cluster-btn');
            if (clusteredMode) {
                btn.classList.add('bg-indigo-50', 'dark:bg-indigo-950/60', 'border-indigo-500', 'text-indigo-600');
                // Cluster nodes by group
                if (network) {
                    try {
                        network.cluster({
                            joinCondition: function(nodeOptions) {
                                return nodeOptions.group === 'branchA';
                            },
                            clusterNodeProperties: {id:'clusterBranchA', label:'Cluster A (Concepts)', font:{size:14, face:'Inter', bold:true}, color:'#6366f1', shape:'ellipse'}
                        });
                        showToast('Graph clustered successfully');
                    } catch(e) { console.log(e); }
                }
            } else {
                btn.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/60', 'border-indigo-500', 'text-indigo-600');
                if (network) {
                    try {
                        network.openCluster('clusterBranchA');
                        showToast('Cluster expanded');
                    } catch(e) { console.log(e); }
                }
            }
        }

        // Live Node Filter by Query
        function filterGraphNodes(query) {
            if (!network) return;
            const q = query.toLowerCase().trim();
            if (!q) {
                renderVisNetwork();
                return;
            }
            // Highlight nodes matching query
            const matchedNodes = allGraphNodes.filter(n => n.id.toLowerCase().includes(q)).map(n => n.id);
            if (matchedNodes.length > 0) {
                network.selectNodes(matchedNodes);
                showToast(`Found ${matchedNodes.length} matching nodes`);
            }
        }

        // History Management
        function addToHistory(topic) {
            searchHistory = searchHistory.filter(item => item !== topic);
            searchHistory.unshift(topic);
            if (searchHistory.length > 30) searchHistory.pop();
            localStorage.setItem('wikigraph_history', JSON.stringify(searchHistory));
        }

        function renderHistoryList() {
            const container = document.getElementById('history-list');
            container.innerHTML = "";
            if (searchHistory.length === 0) {
                container.innerHTML = `<p class="text-sm text-slate-400 text-center py-10">No search history recorded yet.</p>`;
                return;
            }
            searchHistory.forEach((topic, index) => {
                const div = document.createElement('div');
                div.className = "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-2xl flex items-center justify-between shadow-sm hover:border-indigo-500/50 transition";
                div.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 flex items-center justify-center font-bold text-xs">
                            ${index + 1}
                        </div>
                        <span class="font-semibold text-sm">${topic}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="quickSearch('${topic}')" class="px-3 py-1.5 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 rounded-xl text-xs font-medium transition">
                            Explore <i class="fas fa-arrow-right ml-1"></i>
                        </button>
                        <button onclick="removeHistoryItem('${topic}')" class="p-2 text-slate-400 hover:text-red-500 transition">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function removeHistoryItem(topic) {
            searchHistory = searchHistory.filter(item => item !== topic);
            localStorage.setItem('wikigraph_history', JSON.stringify(searchHistory));
            renderHistoryList();
            showToast('History item removed');
        }

        function clearHistory() {
            searchHistory = [];
            localStorage.setItem('wikigraph_history', JSON.stringify(searchHistory));
            renderHistoryList();
            showToast('Search history cleared');
        }

        // Bookmark Management
        function toggleBookmarkCurrent() {
            if (!currentTopic) return;
            const index = bookmarks.indexOf(currentTopic);
            if (index > -1) {
                bookmarks.splice(index, 1);
                showToast(`Removed "${currentTopic}" from bookmarks`);
            } else {
                bookmarks.push(currentTopic);
                showToast(`Bookmarked "${currentTopic}" successfully`);
            }
            localStorage.setItem('wikigraph_bookmarks', JSON.stringify(bookmarks));
            updateBookmarkBadge();
            updateBookmarkButtonState();
        }

        function updateBookmarkButtonState() {
            const btn = document.getElementById('bookmark-btn');
            if (bookmarks.includes(currentTopic)) {
                btn.innerHTML = `<i class="fas fa-bookmark text-lg text-indigo-600 dark:text-indigo-400"></i>`;
                btn.classList.add('bg-indigo-50', 'dark:bg-slate-700');
            } else {
                btn.innerHTML = `<i class="far fa-bookmark text-lg"></i>`;
                btn.classList.remove('bg-indigo-50', 'dark:bg-slate-700');
            }
        }

        function updateBookmarkBadge() {
            document.getElementById('bookmark-badge').innerText = bookmarks.length;
        }

        function renderBookmarksList() {
            const container = document.getElementById('bookmarks-list');
            container.innerHTML = "";
            if (bookmarks.length === 0) {
                container.innerHTML = `<p class="text-sm text-slate-400 col-span-2 text-center py-10">No bookmarks saved yet. Click the bookmark icon on any topic.</p>`;
                return;
            }
            bookmarks.forEach(topic => {
                const card = document.createElement('div');
                card.className = "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-2xl flex items-center justify-between shadow-sm hover:border-indigo-500/50 transition";
                card.innerHTML = `
                    <div class="flex items-center gap-3 truncate">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-500 flex items-center justify-center shrink-0">
                            <i class="fas fa-bookmark"></i>
                        </div>
                        <span class="font-bold text-sm truncate">${topic}</span>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button onclick="quickSearch('${topic}')" class="px-3 py-1.5 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 rounded-xl text-xs font-medium transition">
                            View
                        </button>
                        <button onclick="removeBookmark('${topic}')" class="p-2 text-slate-400 hover:text-red-500 transition">
                            <i class="fas fa-trash-alt text-xs"></i>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function removeBookmark(topic) {
            bookmarks = bookmarks.filter(item => item !== topic);
            localStorage.setItem('wikigraph_bookmarks', JSON.stringify(bookmarks));
            updateBookmarkBadge();
            renderBookmarksList();
            updateBookmarkButtonState();
            showToast('Bookmark removed');
        }

        // Copy Summary to Clipboard
        function copyTopicSummary() {
            if (!currentSummary) return;
            const dummy = document.createElement('textarea');
            document.body.appendChild(dummy);
            dummy.value = `${currentTopic}\n\n${currentSummary}`;
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            showToast('Summary copied to clipboard!');
        }

        // Dark Mode Toggle
        function toggleDarkMode() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                html.classList.add('light');
                icon.className = "fas fa-moon text-lg";
                showToast('Switched to Light Mode');
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                icon.className = "fas fa-sun text-lg";
                showToast('Switched to Dark Mode');
            }
            if (currentTopic) buildAdvancedGraph(currentTopic, currentLinks);
        }

        // Info Modal Helpers
        function openInfoModal() {
            document.getElementById('info-modal').classList.remove('hidden');
        }
        function closeInfoModal() {
            document.getElementById('info-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
